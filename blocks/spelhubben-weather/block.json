{
  "apiVersion": 2,
  "name": "spelhubben-weather/spelhubben-weather",
  "title": "Spelhubben Weather",
  "category": "widgets",
  "icon": "cloud",
  "description": "Current weather and optional daily forecast with map, subtle animations, and multiple layouts.",
  "keywords": ["weather", "forecast", "map"],
  "textdomain": "spelhubben-weather",
  "supports": { "html": false },
  "attributes": {
    "ort":        { "type": "string", "default": "Stockholm" },
    "place":      { "type": "string", "default": "" },
    "lat":        { "type": "string", "default": "" },
    "lon":        { "type": "string", "default": "" },
    "show":       { "type": "string", "default": "temp,wind,wind_dir,icon" },
    "layout":     { "type": "string", "default": "card" },
    "map":        { "type": "boolean", "default": false },
    "mapHeight":  { "type": "number",  "default": 240 },
    "mapEngine":  { "type": "string",  "default": "auto" },
    "animate":    { "type": "boolean", "default": true },
    "forecast":   { "type": "string",  "default": "none" },
    "days":       { "type": "number",  "default": 5 },
    "hourly":     { "type": "boolean", "default": false },
    "hours":      { "type": "number",  "default": 24 },
    "showAlerts": { "type": "boolean", "default": true },
    "tides":      { "type": "boolean", "default": false },
    "theme":      { "type": "string",  "default": "auto" },
    "preset":     { "type": "string",  "default": "" },
    "units":      { "type": "string",  "default": "metric" },
    "date_format":{ "type": "string",  "default": "D j/n" },
    "wind_unit":  { "type": "string",  "default": "" }
  },
  "editorScript": "file:./index.js",
  "style": "sv-vader-style"
}
